# Postgres connection string (Supabase/Neon).
# Leave unset for local development: an embedded database is created in .data/pglite.
DATABASE_URL=

# Disc prices from Coupang (keys are issued after Coupang Partners approval).
# Without them the Coupang collector is skipped.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# The site's public address, for the sitemap and share previews.
# On Vercel this is detected automatically; set it when using your own domain.
SITE_URL=
